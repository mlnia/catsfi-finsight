# ---------------------------------------------------------------------------
# CATsFi FinSight configuration. Copy to .env and adjust. Every value is optional
# unless noted; defaults run fully offline (no API keys) for local testing.
# ---------------------------------------------------------------------------
ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
DATA_DIR=./data

# --- REQUIRED for SEC EDGAR: descriptive User-Agent with a contact e-mail ---
SEC_USER_AGENT="CATsFi FinSight research your.name@example.com"

# --- Access control: "key:role" pairs (viewer | admin). Empty = auth disabled (dev only) ---
API_KEYS=
RATE_LIMIT_PER_MINUTE=60

# --- LLM: offline | openai | azure_openai | anthropic | openai_compatible ---
LLM_PROVIDER=offline
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...          (LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-...)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# openai_compatible examples (Ollama / Gemini / vLLM):
# OPENAI_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash

# --- Retrieval ---
EMBEDDING_PROVIDER=fastembed  # hash (tests) | fastembed (local ONNX) | openai | azure_openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER=cross-encoder        # none | cross-encoder
# QDRANT_URL=http://localhost:6333     # Qdrant server; unset => embedded on-disk store in DATA_DIR/qdrant
TOP_K=6

# --- Guardrails ---
GUARDRAIL_MODE=block          # block | flag
MIN_GROUNDEDNESS=0.55
MASK_PII=true

# --- Prompt versions (A/B) ---
RAG_PROMPT=rag_answer@v2
AGENT_PROMPT=agent_system@v1

# --- Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=catsfi-finsight

# --- Demo deploys: index these tickers in the background on first start ---
SEED_TICKERS=AAPL,MSFT,NVDA
