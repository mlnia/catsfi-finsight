{
  "title": "CATsFi FinSight \u2014 RAG & Agent",
  "uid": "finsight",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "LLM spend (USD, 24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(finsight_llm_cost_usd_total[24h]))",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Median groundedness (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(finsight_groundedness_bucket[1h])) by (le))",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Guardrail interventions (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(finsight_guardrail_events_total[24h]))",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Pending approvals",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "finsight_agent_pending_approvals",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Request latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(finsight_request_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(finsight_request_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "B"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "LLM latency p95 by op",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(finsight_llm_seconds_bucket[5m])) by (le, op))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "LLM tokens / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(finsight_llm_tokens_total[5m])) by (model, direction) * 60",
          "legendFormat": "{{model}} {{direction}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Retrieval latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(finsight_retrieval_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Guardrail events",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(finsight_guardrail_events_total[5m])) by (type, action) * 60",
          "legendFormat": "{{type}} / {{action}}",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Agent tool calls",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(finsight_agent_tool_calls_total[5m])) by (tool, status) * 60",
          "legendFormat": "{{tool}} {{status}}",
          "refId": "A"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Answer cache hits / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(finsight_cache_hits_total[5m])) * 60",
          "legendFormat": "hits",
          "refId": "A"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Ingested chunks",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(finsight_ingested_chunks_total[1h])) by (form)",
          "legendFormat": "{{form}}",
          "refId": "A"
        }
      ],
      "id": 12
    }
  ],
  "tags": [
    "llm",
    "rag"
  ]
}